          "minimum": 0
        },
        "due_today": {
          "type": "integer",
          "minimum": 0
        },
        "upcoming": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "closed": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "line",
          "item",
          "status",
          "status_column",
          "deadline",
          "deadline_column",
          "state",
          "days_to_deadline"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "item": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "status_column": {
            "type": "string"
          },
          "deadline": {
            "type": "string"
          },
          "deadline_column": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "days_to_deadline": {
            "type": [
              "integer",
              "null"
            ]
