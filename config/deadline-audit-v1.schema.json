{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mohammadrezwankhan:bess-qaqc-toolkit:deadline-audit-v1",
  "title": "scripts/audit_deadlines.py JSON deadline audit, schema version 1",
  "description": "Version 1 documents the existing CLI payload without changing it. All current fields are required; additional properties are permitted for compatible additions.",
